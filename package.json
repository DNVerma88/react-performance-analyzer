{
  "name": "react-performance-analyzer",
  "version": "1.0.0",
  "description": "Lightweight zero-runtime-dependency React performance analyzer for detecting unnecessary re-renders, slow components, and unstable props.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "audit:check": "npm audit --audit-level=high",
    "prepublishOnly": "npm run lint && npm run build && npm test && npm run audit:check"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "react",
    "performance",
    "profiler",
    "re-render",
    "analyzer",
    "debug",
    "devtools",
    "hooks",
    "optimization"
  ],
  "author": "Deep Narayan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNVerma88/react-performance-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/DNVerma88/react-performance-analyzer/issues"
  },
  "homepage": "https://github.com/DNVerma88/react-performance-analyzer#readme"
}
